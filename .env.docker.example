# ==============================================================================
# GSFIN - Production Docker Environment Variables
# Copy this file to .env before starting docker compose:
#   cp .env.docker.example .env
# ==============================================================================

# ── General & Ports ──
APP_ENV=production
NODE_ENV=production
HTTP_PORT=80
HTTPS_PORT=443

# ── Domain & URLs ──
FRONTEND_URL=http://localhost
APP_URL=http://localhost/api
NUXT_PUBLIC_API_BASE=/api

# ── MySQL Database ──
MYSQL_ROOT_PASSWORD=gsfin_secure_root_password_change_me
MYSQL_DATABASE=gsfin_db
MYSQL_USER=gsfin_user
MYSQL_PASSWORD=gsfin_user_password_change_me
DB_HOST=mysql
DB_PORT=3306
DB_USER=gsfin_user
DB_PASSWORD=gsfin_user_password_change_me
DB_NAME=gsfin_db

# ── Redis Cache ──
USE_MOCK_REDIS=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT Secrets (Generate secure 64-char strings in production) ──
JWT_ACCESS_SECRET=gsfin_access_secret_production_key_random_change_me_12345
JWT_REFRESH_SECRET=gsfin_refresh_secret_production_key_random_change_me_67890
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d
PUBLIC_EXAM_JWT_SECRET=gsfin_public_exam_token_secret_random_change_me

# ── Email & Notification Service (Resend / SMTP) ──
RESEND_API_KEY=
RESEND_FROM=noreply@gsfin.org
SMTP_FROM_NAME=Global Standards for Food Industries (GSFIN)

# ── Payment Gateway (Optional) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
